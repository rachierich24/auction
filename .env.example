# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local dev uses SQLite so the app runs with zero infrastructure.
# To move to PostgreSQL: set provider = "postgresql" in prisma/schema.prisma
# and point DATABASE_URL at your instance. No application code changes needed.
# Neon DB — pooled URL for app runtime, direct URL for migrations.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Auth — REQUIRED. Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars-long"
SESSION_TTL_DAYS="30"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Kolkata"

# ---------------------------------------------------------------------------
# Storage — "local" writes to ./public/uploads. Swap to "s3" or "supabase".
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="auction-media"

# ---------------------------------------------------------------------------
# Email — "console" logs to stdout. Swap to "resend" in production.
# ---------------------------------------------------------------------------
EMAIL_DRIVER="console"
EMAIL_FROM="Maison Auctions <no-reply@maison.auction>"
# RESEND_API_KEY=""

# ---------------------------------------------------------------------------
# Payments — "mock" settles instantly in dev. Swap to "razorpay"/"cashfree".
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="mock"
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
# CASHFREE_APP_ID=""
# CASHFREE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Scheduled auction settlement (Vercel Cron / external scheduler)
# ---------------------------------------------------------------------------
CRON_SECRET="change-me-cron-secret"
